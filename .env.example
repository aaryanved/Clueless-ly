# Clueless-ly environment configuration.
# Copy this file to `.env` and fill in the values. NEVER commit your real `.env`.

# ---- Required ----
# Your OpenAI API key. Create one at https://platform.openai.com/api-keys
# Do NOT wrap the value in quotes.
OPENAI_API_KEY=

# ---- Optional (sensible defaults are used if left blank) ----
# Chat/answer model used for contextual questions.
OPENAI_MODEL=gpt-4o

# Model used for turning captured audio into text.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Realtime model used for streaming transcription over WebSocket.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Log verbosity: debug | info | warn | error
CLUELESSLY_LOG_LEVEL=info
